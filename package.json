{
  "name": "genraticmed",
  "private": true,
  "version": "1.0.0",
  "description": "genraticMed Rx Vault — monorepo root. Frontend (Vite/React) and Backend (Express/Gemini) are in their own subfolders.",
  "scripts": {
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "build": "npm run build --prefix frontend",
    "lint:frontend": "npm run lint --prefix frontend",
    "lint:backend": "npm run lint --prefix backend",
    "lint": "npm-run-all --parallel lint:frontend lint:backend",
    "db:generate": "npm run db:generate --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:seed": "npm run db:seed --prefix backend"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
